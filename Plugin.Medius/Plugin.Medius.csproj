<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>ServerEmus</Authors>
    <Company>ServerEmus</Company>
    <Copyright>$(Company)</Copyright>
    <Version>0.0.1</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ServerEmus.ServerShared" Version="0.0.16" PrivateAssets="all" ExcludeAssets="runtime" ReferenceOutputAssembly="false" Private="true">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <!-- Protocol/ is vendored from Horizon (MIT, see Protocol/LICENSE.Horizon)
       and kept close to upstream; it predates nullable annotations. -->
  <ItemGroup>
    <Compile Update="Protocol\**\*.cs">
      <Nullable>disable</Nullable>
    </Compile>
  </ItemGroup>

  <!-- MAG's skill/level/item tables, extracted from the retail disc's game.psarc.sdat (see MagSkillTable). -->
  <ItemGroup>
    <!-- Generated by Plugin.MagGameServer's tools/re: charactertables.py per build (v100 = 1.00 game.psarc.sdat, v212 = patch 2.12's tpps.psarc.sdat over it), msgtypes.py from each build's mage_g.elf and EBOOT.elf. -->
    <EmbeddedResource Include="Extensions\Mag\Data\v100\mag-character-tables.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v100.mag-character-tables.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\v212\mag-character-tables.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v212.mag-character-tables.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\v100\mag-char-stat-info.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v100.mag-char-stat-info.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\v212\mag-char-stat-info.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v212.mag-char-stat-info.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\v100\mag-shadow-war.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v100.mag-shadow-war.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\v212\mag-shadow-war.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.v212.mag-shadow-war.json" />
    <EmbeddedResource Include="Extensions\Mag\Data\mag-message-types.json" LogicalName="Plugin.Medius.Extensions.Mag.Data.mag-message-types.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Medius.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Serilog" />
  </ItemGroup>

</Project>
