<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="ServerEmus.ServerShared" Version="0.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Plugin.Medius/Plugin.Medius.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- Plugin.MagGameServer's tests reuse the fixture, test client and MAG client steps. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.MagGameServer.Tests" />
    <!-- tools/MediusProxy.Tests uses the fixture and client as upstream and game. -->
    <InternalsVisibleTo Include="MediusProxy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Data/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
